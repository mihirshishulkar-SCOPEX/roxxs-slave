#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  ROXX KILL INTELLIGENCE — BOOT SEQUENCE v14.1                        ║
# ║  CROSS-PLATFORM: Linux + macOS — OPTIMIZED (no lag, no loop)         ║
# ║  Speed: ROXX_FAST=1 for instant display (CI/slow terminals)          ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Guard: non-interactive terminals skip entirely ─────────────────────
[[ ! -t 1 || ! -t 0 ]] && exit 0

# ── Speed mode: ROXX_FAST=1 bash roxx-banner ──────────────────────────
FAST="${ROXX_FAST:-0}"
if [[ "$FAST" == "1" ]]; then
  T_MATRIX=0; T_BOOT=0; T_SCAN=0.01; T_CVE=0.01
  T_SECRET=0.01; T_CHAIN=0.01; T_BAR=0; T_ART=0
  T_GLYPH=0.02; T_STATUS=0.01; T_LAW=0.01; T_PULSE=0
else
  T_MATRIX=0.025; T_BOOT=0.035; T_SCAN=0.055; T_CVE=0.055
  T_SECRET=0.06; T_CHAIN=0.05; T_BAR=0.012; T_ART=0.003
  T_GLYPH=0.05; T_STATUS=0.035; T_LAW=0.04; T_PULSE=0.008
fi

# ── Detect OS ─────────────────────────────────────────────────────────
OS="$(uname -s 2>/dev/null || echo Linux)"

# ── Terminal width ─────────────────────────────────────────────────────
COLS=$(tput cols 2>/dev/null || echo 80)
[[ $COLS -lt 60 ]] && COLS=80

# ── Colors (pure ANSI — no subshells, no tput color calls) ────────────
R=$'\e[0;31m'  BR=$'\e[1;31m'  G=$'\e[0;32m'  BG=$'\e[1;32m'
Y=$'\e[0;33m'  BY=$'\e[1;33m'  C=$'\e[0;36m'  BC=$'\e[1;36m'
M=$'\e[0;35m'  BM=$'\e[1;35m'  W=$'\e[1;37m'  DM=$'\e[2m'
RV=$'\e[7m'    BD=$'\e[1m'     NC=$'\e[0m'

# ── Helpers — all pure bash, zero subshells in hot paths ──────────────

# Fast random hex — uses $RANDOM, no subshells
_hex() {
  local n="${1:-32}" out="" chars="0123456789ABCDEF"
  local i r
  for ((i=0;i<n;i++)); do
    r=$(( RANDOM % 16 ))
    out+="${chars:$r:1}"
  done
  printf '%s' "$out"
}

_ip()   { printf '%d.%d.%d.%d' $((RANDOM%254+1)) $((RANDOM%254+1)) $((RANDOM%254+1)) $((RANDOM%254+1)); }
_port() { printf '%d' $((RANDOM%65000+1)); }
_ms()   { printf '%dms' $((RANDOM%900+50)); }
_mac()  { printf '%02X:%02X:%02X:%02X:%02X:%02X' \
            $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) \
            $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)); }

# Print a full-width line of a single char
_line() {
  local ch="${1:- }" col="${2:-$DM$R}"
  local s; printf -v s '%*s' "$COLS" ''
  printf '%s%s%s\n' "$col" "${s// /$ch}" "$NC"
}

# Center text
_ctr() {
  local text="$1" col="${2:-$W}"
  local pad=$(( (COLS - ${#text}) / 2 ))
  [[ $pad -lt 0 ]] && pad=0
  printf '%*s%s%s%s\n' "$pad" '' "$col" "$text" "$NC"
}

# Type a line — uses printf loop (no subshell read)
# On slow systems FAST=1 skips char-by-char entirely
_type() {
  local col="$1" text="$2" delay="${3:-0.012}"
  if [[ "$FAST" == "1" || "$delay" == "0" ]]; then
    printf '%s%s%s\n' "$col" "$text" "$NC"
    return
  fi
  local i ch
  for ((i=0; i<${#text}; i++)); do
    ch="${text:$i:1}"
    printf '%s%s%s' "$col" "$ch" "$NC"
    sleep "$delay"
  done
  printf '\n'
}

# Progress bar — pre-build the bar string then print it fast
_bar() {
  local label="$1" w="${2:-32}" col="${3:-$BG}" delay="${4:-$T_BAR}"
  local bar="" i
  printf '  %s%-22s%s [' "$DM$W" "$label" "$NC"
  for ((i=0;i<w;i++)); do
    printf '%s█%s' "$col" "$NC"
    [[ "$delay" != "0" ]] && sleep "$delay"
  done
  printf '] %sDONE%s\n' "$BG" "$NC"
}

# Flash line (uses \r, no subshell)
_flash() {
  local text="$1" col="${2:-$BR}"
  local i
  for ((i=0;i<4;i++)); do
    printf '\r%s%s  %s  %s' "$col" "$RV" "$text" "$NC"; sleep 0.06
    printf '\r%s  %s  %s'   "$col"       "$text" "$NC"; sleep 0.06
  done
  printf '\n'
}

tput civis 2>/dev/null
trap 'tput cnorm 2>/dev/null' EXIT INT TERM
clear

# ════════════════════════════════════════════════════════════════════════
# PHASE 1 ── MATRIX RAIN  (pure bash, no subshells)
# ════════════════════════════════════════════════════════════════════════
RCHARS='ｦｧｨｩｪｫｬｭｮｯｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789ABCDEF!@#$%^&*'
RLEN=${#RCHARS}
for row in 1 2 3 4 5 6 7 8; do
  line=""
  for ((c=0;c<COLS-4;c++)); do line+="${RCHARS:$(( RANDOM%RLEN )):1}"; done
  case $((row%4)) in
    0) printf '  %s%s%s\n' "$BG"   "$line" "$NC" ;;
    1) printf '  %s%s%s\n' "$G"    "$line" "$NC" ;;
    2) printf '  %s%s%s\n' "$DM$G" "$line" "$NC" ;;
    3) printf '  %s%s%s\n' "$DM"   "$line" "$NC" ;;
  esac
  sleep "$T_MATRIX"
done
sleep 0.1; clear

