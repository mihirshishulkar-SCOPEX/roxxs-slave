  "${BG}DISABLED${NC}"  "${BG}BYPASSED${NC}"  "${BG}PATCHED${NC}"
  "${BR}STRIPPED${NC}"  "${BR}DISABLED${NC}"  "${BG}CLOAKED${NC}"
  "${BG}ONLINE × $((RANDOM%4+2))${NC}"
  "${BG}CONNECTED${NC}"
  "${BG}$((RANDOM%5+3)) HOPS${NC}"
