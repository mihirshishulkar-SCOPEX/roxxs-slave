#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  ROXX KILL INTELLIGENCE — BOOT SEQUENCE v14.0                        ║
# ║  CROSS-PLATFORM: Linux + macOS                                        ║
# ╚══════════════════════════════════════════════════════════════════════╝

[[ ! -t 1 || ! -t 0 ]] && exit 0

# ── Detect OS ─────────────────────────────────────────────────────────
OS="$(uname -s)"

# ── Terminal dimensions ────────────────────────────────────────────────
COLS=$(tput cols 2>/dev/null || echo 80)

# ── Colors ────────────────────────────────────────────────────────────
RED='\033[0;31m';    BRED='\033[1;31m'
GREEN='\033[0;32m';  BGREEN='\033[1;32m'
YELLOW='\033[0;33m'; BYELLOW='\033[1;33m'
CYAN='\033[0;36m';   BCYAN='\033[1;36m'
MAGENTA='\033[0;35m';BMAGENTA='\033[1;35m'
WHITE='\033[0;37m';  BWHITE='\033[1;37m'
DIM='\033[2m'; BOLD='\033[1m'; REV='\033[7m'
NC='\033[0m'

# ── Cross-platform helpers ─────────────────────────────────────────────
_rnd_hex() {
  if [[ "$OS" == "Darwin" ]]; then
    LC_ALL=C cat /dev/urandom | tr -dc 'A-F0-9' | head -c "${1:-32}"
  else
    cat /dev/urandom 2>/dev/null | tr -dc 'A-F0-9' | head -c "${1:-32}"
  fi
}
_rnd_ip()   { echo "$((RANDOM%254+1)).$((RANDOM%254+1)).$((RANDOM%254+1)).$((RANDOM%254+1))"; }
_rnd_port() { echo "$((RANDOM%65000+1))"; }
_rnd_mac()  { printf '%02X:%02X:%02X:%02X:%02X:%02X\n' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)); }
_ms()       { echo "$((RANDOM%900+50))ms"; }

_type() {
  local color="$1" text="$2" delay="${3:-0.012}"
  while IFS= read -rn1 ch; do
    printf "${color}%s${NC}" "$ch"; sleep "$delay"
  done <<< "$text"; echo ""
}

_center() {
  local text="$1" color="${2:-$BWHITE}"
  local pad=$(( (COLS - ${#text}) / 2 ))
  printf "%${pad}s"; printf "${color}${text}${NC}\n"
}

_line() {
  local char="${1:-═}" color="${2:-$DIM$RED}"
  printf "${color}"
  printf "%${COLS}s" | tr ' ' "$char"
  printf "${NC}\n"
}

_progress() {
  local label="$1" total="${2:-40}" color="${3:-$BGREEN}" delay="${4:-0.018}"
  printf "  ${DIM}${WHITE}%-22s${NC} [" "$label"
  for ((i=0;i<total;i++)); do printf "${color}█${NC}"; sleep "$delay"; done
  printf "] ${BGREEN}DONE${NC}\n"
}

_flash() {
  local text="$1" color="${2:-$BRED}"
  for i in 1 2 3 4; do
    printf "\r${color}${REV}  ${text}  ${NC}"; sleep 0.06
    printf "\r${color}  ${text}  ${NC}";       sleep 0.06
  done; echo ""
}

tput civis 2>/dev/null
trap 'tput cnorm 2>/dev/null; echo ""' EXIT
clear

# ════════════════════════════════════════════════════════════════════════
# PHASE 1 ── MATRIX RAIN
# ════════════════════════════════════════════════════════════════════════
RCHARS='ｦｧｨｩｪｫｬｭｮｯｰｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789ABCDEF!@#$%^&*'
for row in $(seq 1 9); do
  line=""
  for ((c=0; c<COLS-4; c++)); do
    idx=$(( RANDOM % ${#RCHARS} ))
    line+="${RCHARS:$idx:1}"
  done
  case $((row % 4)) in
    0) echo -e "  ${BGREEN}${line}${NC}" ;;
    1) echo -e "  ${GREEN}${line}${NC}" ;;
    2) echo -e "  ${DIM}${GREEN}${line}${NC}" ;;
    3) echo -e "  ${DIM}${line}${NC}" ;;
  esac
  sleep 0.035
done
sleep 0.15; clear

