for row in $(seq 1 $rain_rows); do
  line=""
  len=$(( COLS - 4 ))
  for ((c=0; c<len; c++)); do
    idx=$(( RANDOM % ${#RCHARS} ))
    line+="${RCHARS:$idx:1}"
  done
  case $((row % 4)) in
    0) echo -e "  ${BGREEN}${line}${NC}" ;;
    1) echo -e "  ${GREEN}${line}${NC}" ;;
    2) echo -e "  ${DIM}${GREEN}${line}${NC}" ;;
    3) echo -e "  ${DIM}${BBLACK}${line}${NC}" ;;
  esac
  sleep 0.035
done

