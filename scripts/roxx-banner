#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════╗
# ║   ROXX KILL INTELLIGENCE — AUTONOMOUS BOOT SEQUENCE v14.0           ║
# ║   HARDEST LEVEL. MAXIMUM AGGRESSION. ZERO LIMITS.                   ║
# ╚══════════════════════════════════════════════════════════════════════╝

[[ ! -t 1 || ! -t 0 ]] && exit 0

# ── Terminal dimensions ────────────────────────────────────────────────
COLS=$(tput cols 2>/dev/null || echo 80)
ROWS=$(tput lines 2>/dev/null || echo 24)

# ── Colors ────────────────────────────────────────────────────────────
BLACK='\033[0;30m';  BBLACK='\033[1;30m'
RED='\033[0;31m';    BRED='\033[1;31m'
GREEN='\033[0;32m';  BGREEN='\033[1;32m'
YELLOW='\033[0;33m'; BYELLOW='\033[1;33m'
BLUE='\033[0;34m';   BBLUE='\033[1;34m'
MAGENTA='\033[0;35m';BMAGENTA='\033[1;35m'
CYAN='\033[0;36m';   BCYAN='\033[1;36m'
WHITE='\033[0;37m';  BWHITE='\033[1;37m'
DIM='\033[2m'; BOLD='\033[1m'; BLINK='\033[5m'; REV='\033[7m'; UL='\033[4m'
NC='\033[0m'

# ── Helpers ────────────────────────────────────────────────────────────
_center() {
  local text="$1" color="${2:-$BWHITE}"
  local pad=$(( (COLS - ${#text}) / 2 ))
  printf "%${pad}s" ""
  printf "${color}${text}${NC}\n"
}

_line() {
  local char="${1:-═}" color="${2:-$DIM$RED}"
  printf "${color}"
  printf "%${COLS}s" | tr ' ' "$char"
  printf "${NC}\n"
}

_type() {
  local color="$1" text="$2" delay="${3:-0.012}"
  while IFS= read -rn1 ch; do
    printf "${color}%s${NC}" "$ch"; sleep "$delay"
  done <<< "$text"; echo ""
}

_rnd_hex()  { cat /dev/urandom 2>/dev/null | tr -dc 'A-F0-9' | head -c "${1:-32}"; }
_rnd_ip()   { echo "$((RANDOM%254+1)).$((RANDOM%254+1)).$((RANDOM%254+1)).$((RANDOM%254+1))"; }
_rnd_port() { echo "$((RANDOM%65000+1))"; }
_rnd_mac()  { printf '%02X:%02X:%02X:%02X:%02X:%02X\n' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)); }
_ms()       { echo "$((RANDOM%900+50))ms"; }

_glitch_line() {
  local text="$1"
  local frames=(
    "$(echo "$text" | tr 'aeiouAEIOU' '@3!0u@3!0')"
    "$(echo "$text" | tr 'stlrSTLR'  '5+1|5+1|')"
    "$(echo "$text" | tr 'ABCDEFGabcdefg' '4BCD3FG4bcd3fg')"
    "$text"
    "$(echo "$text" | sed 's/O/0/g; s/I/!/g; s/S/5/g; s/E/3/g')"
    "$text"
  )
  for f in "${frames[@]}"; do printf "\r${BRED}  ${f}${NC}  "; sleep 0.055; done
  echo ""
}

_flash_line() {
  local text="$1" color="${2:-$BRED}"
  for i in 1 2 3 4; do
    printf "\r${color}${REV}  ${text}  ${NC}"; sleep 0.06
    printf "\r${color}  ${text}  ${NC}";       sleep 0.06
  done; echo ""
}

_progress() {
  local label="$1" total="${2:-50}" color="${3:-$BGREEN}" delay="${4:-0.02}"
  printf "  ${DIM}${WHITE}%-22s${NC} [" "$label"
  for ((i=0;i<total;i++)); do
    printf "${color}█${NC}"; sleep "$delay"
  done
  printf "] ${BGREEN}DONE${NC}\n"
}

_spinner_task() {
  local label="$1" dur="${2:-8}"
  local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local i=0
  for ((t=0;t<dur;t++)); do
    printf "\r  ${BCYAN}${spin[$((i%10))]}${NC}  ${DIM}${WHITE}%-50s${NC}" "$label"
    i=$((i+1)); sleep 0.08
  done
  printf "\r  ${BGREEN}✔${NC}  ${WHITE}%-50s${BGREEN} DONE${NC}\n" "$label"
}

tput civis 2>/dev/null
trap 'tput cnorm 2>/dev/null; echo ""' EXIT
clear

# ════════════════════════════════════════════════════════════════════════
# PHASE 1 ── FULL-SCREEN MATRIX RAIN
# ════════════════════════════════════════════════════════════════════════
RCHARS='ｦｧｨｩｪｫｬｭｮｯｰｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789ABCDEF!@#$%^&*'

